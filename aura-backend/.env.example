# AURA AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API
# The model is configurable. Token budgets are automatically looked up
# from the MODEL_REGISTRY in token-manager.js based on this value.
# Available models:
#   - openai/gpt-oss-120b   (reasoning model, TPM: 8000)
#   - openai/gpt-oss-20b    (reasoning model, TPM: 8000)
#   - llama-3.3-70b-versatile (non-reasoning, TPM: 8000)
#   - llama-3.1-8b-instant    (non-reasoning, TPM: 8000)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Server
PORT=5000
CORS_ORIGIN=http://localhost:4200,http://localhost:4300

# Token limits (optional — if omitted, model-specific defaults from
# MODEL_REGISTRY are used). The agent dynamically clamps max_output to
# TPM_LIMIT - inputTokens before every Groq call, so input + output
# NEVER exceeds the TPM limit.
# MAX_INPUT_TOKENS=4000
# MAX_OUTPUT_TOKENS=1000
# TPM_LIMIT=8000
# TPD_LIMIT=200000
MAX_CONCURRENT_REQUESTS=2
MAX_TOOL_CALLS_PER_REQUEST=5
MAX_AGENT_ITERATIONS=3