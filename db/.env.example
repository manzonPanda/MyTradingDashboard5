# ============================================================================
# AURA Dashboard — local PostgreSQL tooling (db/) — Phase 2
# ============================================================================
# Copy this file to db/.env.local (gitignored) or export the variables in your
# shell. NEVER commit real passwords, and never hard-code them in scripts.
#
# Precedence: process environment  >  db/.env.local  >  the defaults below.
# ============================================================================

# --- Target cluster (local PostgreSQL 18) ----------------------------------
PGHOST=127.0.0.1
PGPORT=5432

# Database + least-privilege application role created by the bootstrap step.
AURA_APP_DB=aura_dashboard
AURA_APP_USER=aura_app

# --- Credentials (set these in your shell or in db/.env.local ONLY) --------
# 1) Superuser used ONLY to create the role/database and to apply DDL.
#    Defaults to the 'postgres' role if unset.
AURA_PG_SUPERUSER=postgres
AURA_PG_SUPERUSER_PASSWORD=

# 2) The password YOU choose for the aura_app application role.
#    Required when the role does not exist yet (never generated for you).
AURA_APP_PASSWORD=

# --- Optional sandbox / dry-run override -----------------------------------
# The same variables can point the tooling at a THROWAWAY cluster instead of
# the real one (used to validate DDL without touching the real database):
#   PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD
# Leave them unset for the real cluster.